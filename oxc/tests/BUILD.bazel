load("//oxc:defs.bzl", "oxc_transpiler")
load(":failure_test.bzl", "failure_test")

package(default_testonly = True)

# Targets carrying JsInfo are allowed in srcs; their outputs are not pre-declared.
js_library(
    name = "legacy_lib",
    srcs = ["src/legacy.js"],
)

# Sources only known at analysis time are transpiled like file srcs, with
# outputs declared then rather than pre-declared. The nested src lands in an
# output directory that only exists because Bazel creates it for the declared
# output: the transpiler does not create it.
filegroup(
    name = "sub_srcs",
    srcs = ["src/sub/index.ts"],
)

oxc_transpiler(
    name = "transpile_target_srcs",
    srcs = [
        "src/main.ts",
        "src/util.mts",
        ":legacy_lib",
        ":sub_srcs",
    ],
    out_dir = "targetsrcs",
    root_dir = "src",
)

build_test(
    name = "target_srcs_test",
    targets = [
        ":transpile_target_srcs",
        "targetsrcs/main.js",
    ],
)

diff_test(
    name = "js_target_srcs_test",
    file1 = "targetsrcs/main.js",
    file2 = "snapshots/main.js",
)

# The "src/*.ts", "src/*.mts" and "src/*.cts" globs also match the
# src/types.d.* declaration sources: those are skipped by the rule and must
# not break the build or produce outputs.
oxc_transpiler(
    name = "transpile",
    srcs = glob([
        "src/*.ts",
        "src/*.tsx",
        "src/*.mts",
        "src/*.cts",
        "src/*.js",
        "src/*.jsx",
        "src/*.mjs",
        "src/*.cjs",
        "src/*.json",
        "src/sub/*.ts",
        "src/nested/**/*.ts",
        "src/nested/**/*.js",
        "src/nested/**/*.json",
    ]),
    emit_dts = True,
    emit_json = True,
    out_dir = "dist",
    root_dir = "src",
)

# Both .js and .d.ts outputs are pre-declared at load time, so they are
# addressable as labels by downstream targets (e.g. js_binary entry_point).
build_test(
    name = "predeclared_outputs_test",
    targets = [
        "dist/main.js",
        "dist/main.d.ts",
        "dist/util.mjs",
        "dist/util.d.mts",
        "dist/legacy.js",
        "dist/component.js",
        "dist/component.d.ts",
        "dist/widget.js",
        "dist/mod.cjs",
        "dist/mod.d.cts",
        "dist/data.json",
        "dist/plain.mjs",
        "dist/plain.cjs",
        "dist/modern.js",
        "dist/modern.d.ts",
        "dist/sub/index.js",
        "dist/sub/index.d.ts",
        "dist/nested/branch.js",
        "dist/nested/branch.d.ts",
        "dist/nested/deep/leaf.js",
        "dist/nested/deep/leaf.d.ts",
        "dist/nested/deep/plain.js",
        "dist/nested/deep/data.json",
        "dist/uses_index.js",
    ],
)

