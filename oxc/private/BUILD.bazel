load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@bazel_skylib//rules:native_binary.bzl", "native_binary")

package(default_visibility = ["//visibility:public"])

bzl_library(
    name = "oxc_transpiler",
    srcs = ["oxc_transpiler.bzl"],
    deps = [
        "@aspect_rules_js//js:providers",
        "@bazel_lib//lib:copy_file",
    ],
)

config_setting(
    name = "darwin_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:arm64",
    ],
)

config_setting(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:arm64",
    ],
)

config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

# Prebuilt transpiler binary for the current platform, built from the isolated
# transpiler/ module and fetched via http_file in MODULE.bazel.
# Used with cfg = "exec", so the select() resolves against the exec platform.
native_binary(
    name = "transpiler",
    src = select({
        ":darwin_arm64": "@transpiler_aarch64_apple_darwin//file",
        ":linux_arm64": "@transpiler_aarch64_unknown_linux_gnu//file",
        ":linux_x86_64": "@transpiler_x86_64_unknown_linux_gnu//file",
    }),
    out = "transpiler_bin",
)
