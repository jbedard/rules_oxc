# use_define_for_class_fields defaults like tsc: define semantics for the default
# (esnext) target keep the declared field, while a target below es2022 removes
# it and assigns the initialized field in the constructor. Setting the attribute
# overrides the target-derived default either way; define semantics below es2022
# downlevel the fields through the defineProperty helper imported from
# @oxc-project/runtime, like tsc's Object.defineProperty emit, so the runtime
# package becomes a runtime dependency. helpers_module redirects that import.
# Assign semantics on es2022 and above initialize statics in a static block,
# below es2022 by assignment after the class.
[
    (
        oxc_transpiler(
            name = "transpile_class_fields_" + name,
            srcs = ["src/fields.ts"],
            emit_dts = True,
            helpers_module = helpers_module,
            out_dir = "classfields_" + name,
            root_dir = "src",
            target = target,
            use_define_for_class_fields = use_define,
        ),
        diff_test(
            name = "class_fields_" + name + "_test",
            file1 = "classfields_" + name + "/fields.js",
            file2 = "snapshots/fields_" + snapshot + ".js",
        ),
        diff_test(
            name = "class_fields_" + name + "_dts_test",
            file1 = "classfields_" + name + "/fields.d.ts",
            file2 = "snapshots/fields.d.ts",
        ),
    )
    for name, target, use_define, helpers_module, snapshot in [
        ("default", "", None, "", "define"),
        ("es2022", "es2022", None, "", "define"),
        ("es2021", "es2021", None, "", "assign"),
        ("es2015", "es2015", None, "", "assign"),
