"""Isolated module building the OXC transpiler binary.

Not a dependency of the main rules_oxc module: binaries built from this module
are published to GitHub releases, and the main module fetches those prebuilds
with http_file. See .github/workflows/release-transpiler.yaml.
"""

module(
    name = "rules_oxc_transpiler",
    version = "0.0.0",
    bazel_compatibility = [">=8.6.0"],
)

bazel_dep(name = "rules_rs", version = "0.0.107")
bazel_dep(name = "llvm", version = "0.8.18")

toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
toolchains.toolchain(
    edition = "2024",
    version = "1.95.0",
)
use_repo(toolchains, "default_rust_toolchains")

# Keeps @rules_rust references working via the rules_rs facade.
rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, "rules_rust")

register_toolchains(
    "@default_rust_toolchains//...",
    "@llvm//toolchain:all",
)

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "oxc_crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    platform_triples = [
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
        "aarch64-apple-darwin",
    ],
)
use_repo(crate, "oxc_crates")
