"Bazel dependencies"

module(
    name = "rules_oxc",
    version = "0.0.0",
    bazel_compatibility = [">=8.6.0"],
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")

# For the JsInfo provider.
bazel_dep(name = "aspect_rules_js", version = "3.0.1")

# For ts_lib.files_relative_to_package()
bazel_dep(name = "aspect_rules_ts", version = "3.9.1")

bazel_dep(name = "gazelle", version = "0.53.0", dev_dependency = True)
bazel_dep(name = "bazel_skylib_gazelle_plugin", version = "1.8.2", dev_dependency = True)
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.3", dev_dependency = True)

# Prebuilt transpiler binaries, built from the isolated module in
# private/transpiler and published to GitHub releases. Platform selection
# happens in //oxc/private:transpiler.
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

# TODO: pin sha256 for each binary after the first transpiler release is published.
TRANSPILER_VERSION = "0.0.1"

http_file(
    name = "transpiler_aarch64_apple_darwin",
    executable = True,
    url = "https://github.com/jbedard/rules_oxc/releases/download/transpiler-v" + TRANSPILER_VERSION + "/transpiler-aarch64-apple-darwin",
)

http_file(
    name = "transpiler_aarch64_unknown_linux_gnu",
    executable = True,
    url = "https://github.com/jbedard/rules_oxc/releases/download/transpiler-v" + TRANSPILER_VERSION + "/transpiler-aarch64-unknown-linux-gnu",
)

http_file(
    name = "transpiler_x86_64_unknown_linux_gnu",
    executable = True,
    url = "https://github.com/jbedard/rules_oxc/releases/download/transpiler-v" + TRANSPILER_VERSION + "/transpiler-x86_64-unknown-linux-gnu",
)
