load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("//oxc:defs.bzl", "oxc_transpiler")

package(default_testonly = True)

oxc_transpiler(
    name = "transpile",
    srcs = glob([
        "src/*.ts",
        "src/*.tsx",
        "src/*.mts",
        "src/*.js",
        "src/*.jsx",
    ]),
    emit_dts = True,
    out_dir = "dist",
    root_dir = "src",
)

# Both .js and .d.ts outputs are pre-declared at load time, so they are
# addressable as labels by downstream targets (e.g. js_binary entry_point).
build_test(
    name = "predeclared_outputs_test",
    targets = [
        "dist/main.js",
        "dist/main.d.ts",
        "dist/util.mjs",
        "dist/util.d.mts",
        "dist/legacy.js",
        "dist/component.js",
        "dist/component.d.ts",
        "dist/widget.js",
    ],
)

diff_test(
    name = "js_legacy_test",
    file1 = "dist/legacy.js",
    file2 = "snapshots/legacy.js",
)

diff_test(
    name = "js_component_test",
    file1 = "dist/component.js",
    file2 = "snapshots/component.js",
)

diff_test(
    name = "dts_component_test",
    file1 = "dist/component.d.ts",
    file2 = "snapshots/component.d.ts",
)

diff_test(
    name = "js_widget_test",
    file1 = "dist/widget.js",
    file2 = "snapshots/widget.js",
)

# Same JSX sources with preserve_jsx: JSX left untouched, .jsx outputs.
oxc_transpiler(
    name = "transpile_preserve_jsx",
    srcs = [
        "src/component.tsx",
        "src/widget.jsx",
    ],
    emit_dts = True,
    out_dir = "preserve",
    preserve_jsx = True,
    root_dir = "src",
)

diff_test(
    name = "preserve_jsx_component_test",
    file1 = "preserve/component.jsx",
    file2 = "snapshots/component.jsx",
)

diff_test(
    name = "preserve_jsx_widget_test",
    file1 = "preserve/widget.jsx",
    file2 = "snapshots/widget.jsx",
)

diff_test(
    name = "js_main_test",
    file1 = "dist/main.js",
    file2 = "snapshots/main.js",
)

diff_test(
    name = "js_util_test",
    file1 = "dist/util.mjs",
    file2 = "snapshots/util.mjs",
)

diff_test(
    name = "dts_main_test",
    file1 = "dist/main.d.ts",
    file2 = "snapshots/main.d.ts",
)

diff_test(
    name = "dts_util_test",
    file1 = "dist/util.d.mts",
    file2 = "snapshots/util.d.mts",
)

# Explicit relative extensions on imports (e.g. "./target_ts.ts") are left
# untouched by default, matching tsc's/swc's out-of-the-box behavior.
_REWRITE_EXTENSIONS_SRCS = [
    "src/rewrite_extensions/main.ts",
    "src/rewrite_extensions/target_cts.cts",
    "src/rewrite_extensions/target_mts.mts",
    "src/rewrite_extensions/target_ts.ts",
    "src/rewrite_extensions/target_tsx.tsx",
]

oxc_transpiler(
    name = "transpile_rewrite_extensions_off",
    srcs = _REWRITE_EXTENSIONS_SRCS,
    out_dir = "rewrite_off",
    root_dir = "src",
)

diff_test(
    name = "rewrite_extensions_off_test",
    file1 = "rewrite_off/rewrite_extensions/main.js",
    file2 = "snapshots/main_extensions_off.js",
)

# With rewrite_extensions, ".ts"/".tsx"/".mts"/".cts" specifiers are rewritten
# to their emitted JS extension, mirroring tsc's rewriteRelativeImportExtensions
# and swc's jsc.rewriteRelativeImportExtensions.
oxc_transpiler(
    name = "transpile_rewrite_extensions_on",
    srcs = _REWRITE_EXTENSIONS_SRCS,
    out_dir = "rewrite_on",
    rewrite_extensions = True,
    root_dir = "src",
)

diff_test(
    name = "rewrite_extensions_on_test",
    file1 = "rewrite_on/rewrite_extensions/main.js",
    file2 = "snapshots/main_extensions_on.js",
)
