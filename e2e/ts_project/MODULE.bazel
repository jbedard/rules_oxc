bazel_dep(name = "aspect_rules_oxc", version = "0.0.0", dev_dependency = True)
bazel_dep(name = "bazel_skylib", version = "1.7.1", dev_dependency = True)
bazel_dep(name = "aspect_rules_ts", version = "3.9.1", dev_dependency = True)

local_path_override(
    module_name = "aspect_rules_oxc",
    path = "../..",
)

# Provides @npm_typescript required by ts_project.
rules_ts_ext = use_extension("@aspect_rules_ts//ts:extensions.bzl", "ext", dev_dependency = True)
rules_ts_ext.deps()
use_repo(rules_ts_ext, "npm_typescript")
