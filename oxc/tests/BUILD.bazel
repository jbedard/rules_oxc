load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("//oxc:defs.bzl", "oxc_transpiler")

package(default_testonly = True)

# Targets carrying JsInfo are allowed in srcs; their outputs are not pre-declared.
js_library(
    name = "legacy_lib",
    srcs = ["src/legacy.js"],
)

oxc_transpiler(
    name = "transpile_target_srcs",
    srcs = [
        "src/main.ts",
        "src/util.mts",
        ":legacy_lib",
    ],
    out_dir = "targetsrcs",
    root_dir = "src",
)

build_test(
    name = "target_srcs_test",
    targets = [
        ":transpile_target_srcs",
        "targetsrcs/main.js",
    ],
)

diff_test(
    name = "js_target_srcs_test",
    file1 = "targetsrcs/main.js",
    file2 = "snapshots/main.js",
)

# The "src/*.ts" glob also matches src/types.d.ts: declaration sources are
# skipped by the rule and must not break the build or produce outputs.
oxc_transpiler(
    name = "transpile",
    srcs = glob([
        "src/*.ts",
        "src/*.tsx",
        "src/*.mts",
        "src/*.cts",
        "src/*.js",
        "src/*.jsx",
        "src/*.json",
        "src/sub/*.ts",
    ]),
    emit_dts = True,
    out_dir = "dist",
    root_dir = "src",
)

# Both .js and .d.ts outputs are pre-declared at load time, so they are
# addressable as labels by downstream targets (e.g. js_binary entry_point).
build_test(
    name = "predeclared_outputs_test",
    targets = [
        "dist/main.js",
        "dist/main.d.ts",
        "dist/util.mjs",
        "dist/util.d.mts",
        "dist/legacy.js",
        "dist/component.js",
        "dist/component.d.ts",
        "dist/widget.js",
        "dist/mod.cjs",
        "dist/mod.d.cts",
        "dist/data.json",
        "dist/sub/index.js",
        "dist/uses_index.js",
    ],
)

# JSON sources are copied through unchanged.
diff_test(
    name = "json_test",
    file1 = "dist/data.json",
    file2 = "src/data.json",
)

diff_test(
    name = "js_mod_test",
    file1 = "dist/mod.cjs",
    file2 = "snapshots/mod.cjs",
)

diff_test(
    name = "dts_mod_test",
    file1 = "dist/mod.d.cts",
    file2 = "snapshots/mod.d.cts",
)

# Extensionless import of a directory resolves to its index file.
diff_test(
    name = "js_uses_index_test",
    file1 = "dist/uses_index.js",
    file2 = "snapshots/uses_index.js",
)

diff_test(
    name = "js_legacy_test",
    file1 = "dist/legacy.js",
    file2 = "snapshots/legacy.js",
)

diff_test(
    name = "js_component_test",
    file1 = "dist/component.js",
    file2 = "snapshots/component.js",
)

diff_test(
    name = "dts_component_test",
    file1 = "dist/component.d.ts",
    file2 = "snapshots/component.d.ts",
)

diff_test(
    name = "js_widget_test",
    file1 = "dist/widget.js",
    file2 = "snapshots/widget.js",
)

# Same JSX sources with preserve_jsx: JSX left untouched, .jsx outputs.
oxc_transpiler(
    name = "transpile_preserve_jsx",
    srcs = [
        "src/component.tsx",
        "src/widget.jsx",
    ],
    emit_dts = True,
    out_dir = "preserve",
    preserve_jsx = True,
    root_dir = "src",
)

diff_test(
    name = "preserve_jsx_component_test",
    file1 = "preserve/component.jsx",
    file2 = "snapshots/component.jsx",
)

diff_test(
    name = "preserve_jsx_widget_test",
    file1 = "preserve/widget.jsx",
    file2 = "snapshots/widget.jsx",
)

diff_test(
    name = "js_main_test",
    file1 = "dist/main.js",
    file2 = "snapshots/main.js",
)

diff_test(
    name = "js_util_test",
    file1 = "dist/util.mjs",
    file2 = "snapshots/util.mjs",
)

diff_test(
    name = "dts_main_test",
    file1 = "dist/main.d.ts",
    file2 = "snapshots/main.d.ts",
)

diff_test(
    name = "dts_util_test",
    file1 = "dist/util.d.mts",
    file2 = "snapshots/util.d.mts",
)

# Explicit relative extensions on imports (e.g. "./target_ts.ts") are left
# untouched by default, matching tsc's/swc's out-of-the-box behavior.
_REWRITE_EXTENSIONS_SRCS = [
    "src/rewrite_extensions/main.ts",
    "src/rewrite_extensions/target_cts.cts",
    "src/rewrite_extensions/target_mts.mts",
    "src/rewrite_extensions/target_ts.ts",
    "src/rewrite_extensions/target_tsx.tsx",
]

oxc_transpiler(
    name = "transpile_rewrite_extensions_off",
    srcs = _REWRITE_EXTENSIONS_SRCS,
    out_dir = "rewrite_off",
    root_dir = "src",
)

diff_test(
    name = "rewrite_extensions_off_test",
    file1 = "rewrite_off/rewrite_extensions/main.js",
    file2 = "snapshots/main_extensions_off.js",
)

# With rewrite_extensions, ".ts"/".tsx"/".mts"/".cts" specifiers are rewritten
# to their emitted JS extension, mirroring tsc's rewriteRelativeImportExtensions
# and swc's jsc.rewriteRelativeImportExtensions.
oxc_transpiler(
    name = "transpile_rewrite_extensions_on",
    srcs = _REWRITE_EXTENSIONS_SRCS,
    out_dir = "rewrite_on",
    rewrite_extensions = True,
    root_dir = "src",
)

diff_test(
    name = "rewrite_extensions_on_test",
    file1 = "rewrite_on/rewrite_extensions/main.js",
    file2 = "snapshots/main_extensions_on.js",
)

# rewrite_extensions combined with preserve_jsx: ".tsx" specifiers are
# rewritten to the ".jsx" extension that preserve_jsx outputs use.
oxc_transpiler(
    name = "transpile_rewrite_extensions_preserve_jsx",
    srcs = _REWRITE_EXTENSIONS_SRCS,
    out_dir = "rewrite_preserve",
    preserve_jsx = True,
    rewrite_extensions = True,
    root_dir = "src",
)

diff_test(
    name = "rewrite_extensions_preserve_jsx_test",
    file1 = "rewrite_preserve/rewrite_extensions/main.js",
    file2 = "snapshots/main_extensions_preserve_jsx.js",
)

# source_maps: each JS output gains a sourceMappingURL comment and a sibling
# .js.map file. The .map is declared as an action output, so building the
# target fails if it is not written.
oxc_transpiler(
    name = "transpile_source_maps",
    srcs = ["src/main.ts"],
    out_dir = "maps",
    root_dir = "src",
    source_maps = True,
)

build_test(
    name = "source_maps_test",
    targets = [":transpile_source_maps"],
)

diff_test(
    name = "js_source_maps_test",
    file1 = "maps/main.js",
    file2 = "snapshots/main_with_map.js",
)

# No out_dir/root_dir: outputs land next to their sources. Plain JS sources
# (e.g. src/legacy.js) can't be used here as output would equal input, but
# .jsx works since the JSX transform emits .js.
oxc_transpiler(
    name = "transpile_in_place",
    srcs = [
        "src/component.tsx",
        "src/main.ts",
        "src/util.mts",
        "src/widget.jsx",
    ],
    emit_dts = True,
)

build_test(
    name = "in_place_outputs_test",
    targets = [
        "src/main.js",
        "src/main.d.ts",
        "src/util.mjs",
        "src/util.d.mts",
        "src/component.js",
        "src/component.d.ts",
        "src/widget.js",
    ],
)

diff_test(
    name = "js_in_place_test",
    file1 = "src/main.js",
    file2 = "snapshots/main.js",
)

diff_test(
    name = "dts_in_place_test",
    file1 = "src/main.d.ts",
    file2 = "snapshots/main.d.ts",
)

diff_test(
    name = "js_widget_in_place_test",
    file1 = "src/widget.js",
    file2 = "snapshots/widget.js",
)

# preserve_jsx in place: .tsx emits .jsx, so outputs don't collide with
# inputs. .jsx sources would collide (output ext is also .jsx).
oxc_transpiler(
    name = "transpile_preserve_jsx_in_place",
    srcs = ["src/component.tsx"],
    preserve_jsx = True,
)

diff_test(
    name = "preserve_jsx_in_place_test",
    file1 = "src/component.jsx",
    file2 = "snapshots/component.jsx",
)

# root_dir without out_dir: outputs land at the package root.
oxc_transpiler(
    name = "transpile_root_dir_only",
    srcs = ["src/main.ts"],
    emit_dts = True,
    root_dir = "src",
)

build_test(
    name = "root_dir_only_outputs_test",
    targets = [
        "main.js",
        "main.d.ts",
    ],
)

diff_test(
    name = "js_root_dir_only_test",
    file1 = "main.js",
    file2 = "snapshots/main.js",
)

# emit_js = False: only declarations are emitted, and DefaultInfo falls back
# to the types when there are no JS outputs.
oxc_transpiler(
    name = "transpile_dts_only",
    srcs = ["src/main.ts"],
    emit_dts = True,
    emit_js = False,
    out_dir = "dtsonly",
    root_dir = "src",
)

build_test(
    name = "dts_only_test",
    targets = [":transpile_dts_only"],
)

diff_test(
    name = "dts_only_main_test",
    file1 = "dtsonly/main.d.ts",
    file2 = "snapshots/main.d.ts",
)
