    name = "transpile_source_maps_no_js",
    srcs = ["src/main.ts"],
    emit_dts = True,
    emit_js = False,
    out_dir = "mapsnojs",
    root_dir = "src",
    source_maps = True,
    tags = ["manual"],
)

failure_test(
    name = "source_maps_require_emit_js_test",
    expected_failure = "source_maps and inline_source_maps require emit_js",
    target_under_test = ":transpile_source_maps_no_js",
)

oxc_transpiler(
    name = "transpile_inline_source_maps_no_js",
    srcs = ["src/main.ts"],
    emit_dts = True,
    emit_js = False,
    inline_source_maps = True,
    out_dir = "inlinemapsnojs",
    root_dir = "src",
    tags = ["manual"],
)

failure_test(
    name = "inline_source_maps_require_emit_js_test",
    expected_failure = "source_maps and inline_source_maps require emit_js",
    target_under_test = ":transpile_inline_source_maps_no_js",
)

# cpus only parallelizes the transpile action; outputs are unchanged.
oxc_transpiler(
    name = "transpile_cpus",
    srcs = [
        "src/main.ts",
        "src/util.mts",
    ],
    cpus = 2,
    out_dir = "cpustest",
    root_dir = "src",
)

diff_test(
    name = "cpus_test",
    file1 = "cpustest/main.js",
    file2 = "snapshots/main.js",
)

oxc_transpiler(
    name = "transpile_negative_cpus",
    srcs = ["src/main.ts"],
    cpus = -1,
    out_dir = "negcpus",
    root_dir = "src",
    tags = ["manual"],
)

failure_test(
    name = "negative_cpus_test",
    expected_failure = "cpus must be positive, or 0 to derive it from the number of srcs",
    target_under_test = ":transpile_negative_cpus",
)

# Runtime tests: execute transpiled output under node. Fixtures are .mts so
# the .mjs outputs run as ESM without a package.json, and assert with
# node:assert so a failure exits nonzero (unhandled rejections included).
oxc_transpiler(
    name = "transpile_rt_smoke",
    srcs = [
        "src/rt/lib.mts",
        "src/rt/smoke_check.mts",
    ],
    out_dir = "rt",
    root_dir = "src/rt",
)

# Type stripping and verbatim relative imports produce runnable ESM.
js_test(
    name = "rt_smoke_test",
    size = "small",
    data = ["rt/lib.mjs"],
    entry_point = "rt/smoke_check.mjs",
)

# The emitted bare helper specifier (custom-helpers/helpers/asyncToGenerator,
# no extension) resolves through a real package exports map, and the
# downleveled async function behaves like the original at runtime.
npm_link_package(
    name = "node_modules/custom-helpers",
    src = "//oxc/tests/runtime_helpers:custom_helpers",
)

oxc_transpiler(
    name = "transpile_rt_helpers",
    srcs = ["src/rt/async_check.mts"],
    helpers_module = "custom-helpers",
    out_dir = "rthelpers",
    root_dir = "src/rt",
    target = "es2016",
)

js_test(
    name = "rt_helpers_test",
    size = "small",
    data = [":node_modules/custom-helpers"],
    entry_point = "rthelpers/async_check.mjs",
)
